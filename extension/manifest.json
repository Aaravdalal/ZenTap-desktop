{
  "manifest_version": 3,
  "name": "ZenTap",
  "version": "1.0.0",
  "description": "Closes tabs for the sites on your ZenTap list while a session is running, and reports per-site time back to the desktop app.",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "tabs",
    "alarms",
    "storage",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ZenTap",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
